table attribution_customer_journeys
	lineageTag: 03de9ea3-3104-4085-bac3-4ffe18b70af9

	measure 'Total Journeys' = DISTINCTCOUNT(attribution_customer_journeys[journey_id])
		formatString: #,0
		displayFolder: Core Business
		lineageTag: c0b83de0-53a7-48c9-bc7d-8855f08f727c

	measure 'Converted Journeys' = CALCULATE(DISTINCTCOUNT(attribution_customer_journeys[journey_id]), attribution_customer_journeys[journey_converted] = 1)
		formatString: #,0
		displayFolder: Core Business
		lineageTag: a172fb1f-c5f2-4bcf-a769-a5e726c59077

	measure 'Conversion Rate' = DIVIDE([Converted Journeys], [Total Journeys])
		formatString: 0.0%
		displayFolder: Core Business
		lineageTag: 83e31419-5642-4589-a47e-a065fcc7c3ad

	measure 'Total Touchpoints' = COUNTROWS(attribution_customer_journeys)
		formatString: #,0
		displayFolder: Core Business
		lineageTag: 3445c759-0595-48bf-a023-fcd2175ddf7f

	measure 'Avg Touchpoints per Journey' = DIVIDE([Total Touchpoints], [Total Journeys])
		formatString: 0.00
		displayFolder: Core Business
		lineageTag: c51c8ea2-d126-43dc-9464-0c79d9e6a06f

	measure 'Total Marketing Spend' = SUM(attribution_customer_journeys[touchpoint_cost_usd])
		formatString: \$#,0.00
		displayFolder: Core Business
		lineageTag: 17951e19-809c-40e4-93d6-51d4e86b903e

	measure 'Campaign Count' = DISTINCTCOUNT(attribution_customer_journeys[campaign_name])
		formatString: #,0
		displayFolder: Campaign Performance
		lineageTag: f5d97f0d-9124-45cc-b11d-7cda5919cd59

	measure 'Journeys with No Campaign' = CALCULATE(DISTINCTCOUNT(attribution_customer_journeys[journey_id]), attribution_customer_journeys[campaign_name] = "(No Campaign)")
		formatString: #,0
		displayFolder: Campaign Performance
		lineageTag: 71e14856-f58d-4b25-8475-2dc3046c12b8

	measure 'Distinct Customers' = DISTINCTCOUNT(attribution_customer_journeys[customer_id])
		formatString: #,0
		displayFolder: Customer Analysis
		lineageTag: bafcab07-eb2c-4283-bf48-075728dd5545

	measure 'Converted Customers' = CALCULATE(DISTINCTCOUNT(attribution_customer_journeys[customer_id]), attribution_customer_journeys[journey_converted] = 1)
		formatString: #,0
		displayFolder: Customer Analysis
		lineageTag: 405373dc-7fb0-4c2d-8c58-5cde1039cb0b

	measure 'Avg Journeys per Customer' = DIVIDE([Total Journeys], [Distinct Customers])
		formatString: 0.00
		displayFolder: Customer Analysis
		lineageTag: e81bfb82-08a8-4757-a4de-6b654ba379ae

	measure 'Revenue per Converted Customer (Linear)' = DIVIDE([Linear Revenue], [Converted Customers])
		formatString: \$#,0.00
		displayFolder: Customer Analysis
		lineageTag: 4a6c6f0c-50bb-4d4f-95b5-bdc1479385c3

	measure 'Avg Days to Conversion' = AVERAGEX(SUMMARIZE(FILTER(attribution_customer_journeys, attribution_customer_journeys[journey_converted]=1), attribution_customer_journeys[journey_id], "d", MAX(attribution_customer_journeys[days_to_conversion])), [d])
		formatString: 0.00
		displayFolder: Time Analysis
		lineageTag: e0e305dd-441f-455b-b7c3-dec3d1645e5b

	measure 'Median Days to Conversion' = MEDIANX(SUMMARIZE(FILTER(attribution_customer_journeys, attribution_customer_journeys[journey_converted]=1), attribution_customer_journeys[journey_id], "d", MAX(attribution_customer_journeys[days_to_conversion])), [d])
		formatString: 0.0
		displayFolder: Time Analysis
		lineageTag: ac873334-5b1b-4ba1-9170-628c0c5377db

