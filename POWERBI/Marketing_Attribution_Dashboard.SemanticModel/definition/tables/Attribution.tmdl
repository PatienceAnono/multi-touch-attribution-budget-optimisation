table Attribution
	lineageTag: b2b5f68e-23f0-4ac8-9715-749e43c6e43d

	measure 'Total Conversion Revenue' = SUMX(DISTINCT(Attribution[journey_id]), CALCULATE(MAX(Attribution[journey_order_value])))
		formatString: \$#,0.00
		displayFolder: Core Business
		lineageTag: f03129d9-d690-47d7-89e3-24f4037699e3

	measure 'First Touch Revenue' = SUM(Attribution[first_touch_revenue])
		formatString: \$#,0.00
		displayFolder: Attribution Models
		lineageTag: fef0ddf8-2a1d-46f2-9cc3-e09206a7bc3d

	measure 'Last Touch Revenue' = SUM(Attribution[last_touch_revenue])
		formatString: \$#,0.00
		displayFolder: Attribution Models
		lineageTag: 47eb104f-277a-46e0-955e-a9a066111a02

	measure 'Linear Revenue' = SUM(Attribution[linear_revenue])
		formatString: \$#,0.00
		displayFolder: Attribution Models
		lineageTag: 7811f942-9c2c-4ca9-a145-bac01fa52df4

	measure 'Time Decay Revenue' = SUM(Attribution[time_decay_revenue])
		formatString: \$#,0.00
		displayFolder: Attribution Models
		lineageTag: a9ad12fb-ab6f-4bdf-bac6-571d434b7491

	measure 'Position Based Revenue' = SUM(Attribution[position_based_revenue])
		formatString: \$#,0.00
		displayFolder: Attribution Models
		lineageTag: cdefde9d-9cd3-4b53-866b-6647f211461a

	measure 'Max Model Revenue' = MAXX(UNION(ROW("v",[First Touch Revenue]),ROW("v",[Last Touch Revenue]),ROW("v",[Linear Revenue]),ROW("v",[Time Decay Revenue]),ROW("v",[Position Based Revenue])),[v])
		formatString: \$#,0.00
		displayFolder: Model Comparison
		lineageTag: 60a7193f-4bd4-49f8-abe6-84d44ef80a4e

	measure 'Min Model Revenue' = MINX(UNION(ROW("v",[First Touch Revenue]),ROW("v",[Last Touch Revenue]),ROW("v",[Linear Revenue]),ROW("v",[Time Decay Revenue]),ROW("v",[Position Based Revenue])),[v])
		formatString: \$#,0.00
		displayFolder: Model Comparison
		lineageTag: eb35ad5c-76b6-46a8-864c-486684a8c120

	measure 'Model Revenue Spread' = [Max Model Revenue] - [Min Model Revenue]
		formatString: \$#,0.00
		displayFolder: Model Comparison
		lineageTag: f97fd848-74b8-448d-964e-fa1c3f83d6a3

	measure 'ROAS First Touch' = DIVIDE([First Touch Revenue], [Total Marketing Spend])
		formatString: 0.00
		displayFolder: Channel Performance
		lineageTag: bb344f91-541b-45be-8976-a69cc8e38724

	measure 'ROAS Last Touch' = DIVIDE([Last Touch Revenue], [Total Marketing Spend])
		formatString: 0.00
		displayFolder: Channel Performance
		lineageTag: a5f16118-20c1-4537-93e9-13d885380ae1

	measure 'ROAS Linear' = DIVIDE([Linear Revenue], [Total Marketing Spend])
		formatString: 0.00
		displayFolder: Channel Performance
		lineageTag: 172b246f-f12a-4a6c-99c5-80b155c7252f

	measure 'ROAS Time Decay' = DIVIDE([Time Decay Revenue], [Total Marketing Spend])
		formatString: 0.00
		displayFolder: Channel Performance
		lineageTag: 5f7c13ce-7ccc-40fc-b85c-5b5bf9483388

	measure 'ROAS Position Based' = DIVIDE([Position Based Revenue], [Total Marketing Spend])
		formatString: 0.00
		displayFolder: Channel Performance
		lineageTag: dcef6d46-e412-47b1-b5d8-3ef11a2d730c

	measure 'Cost per Conversion First Touch' = DIVIDE([Total Marketing Spend], SUM(Attribution[first_touch_weight]))
		formatString: \$#,0.00
		displayFolder: Channel Performance
		lineageTag: fbe335a4-cb0e-46ac-8cab-d82b161426d3

	measure 'Cost per Conversion Last Touch' = DIVIDE([Total Marketing Spend], SUM(Attribution[last_touch_weight]))
