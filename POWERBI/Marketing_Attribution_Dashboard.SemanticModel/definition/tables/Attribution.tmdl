		lineageTag: 54493a20-dd5e-4d5e-acdc-503c69037725

	measure 'Cost per Conversion Time Decay' = DIVIDE([Total Marketing Spend], SUM(Attribution[time_decay_weight]))
		formatString: \$#,0.00
		displayFolder: Channel Performance
		lineageTag: 0c4a405e-b518-442b-aa58-1e5def378abb

	measure 'Cost per Conversion Position Based' = DIVIDE([Total Marketing Spend], SUM(Attribution[position_based_weight]))
		formatString: \$#,0.00
		displayFolder: Channel Performance
		lineageTag: 835a1134-7b73-4e52-9453-3b0c1fc2b4b5

	measure 'QA First Touch Diff' = [First Touch Revenue] - [Total Conversion Revenue]
		formatString: \$#,0.0000
		displayFolder: QA and Reconciliation
		lineageTag: b87c61c4-9661-4c08-838f-fc11230a672e

	measure 'QA Last Touch Diff' = [Last Touch Revenue] - [Total Conversion Revenue]
