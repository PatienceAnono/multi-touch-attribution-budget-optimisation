		lineageTag: 3f552d80-17cc-4435-a4d4-e44783a849eb

	measure 'QA Weight Sum Check First Touch' = SUM(Attribution[first_touch_weight]) - DISTINCTCOUNT(Attribution[journey_id])
		formatString: 0.0000
		displayFolder: QA and Reconciliation
		lineageTag: 067a0ebb-10fa-4f9b-af45-36f8c8390fde

