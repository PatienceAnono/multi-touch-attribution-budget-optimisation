model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-KE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DataFolder","attribution_customer_journeys","Attribution"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table attribution_customer_journeys
ref table Attribution
ref table Date
ref table DimChannel

ref cultureInfo en-US

